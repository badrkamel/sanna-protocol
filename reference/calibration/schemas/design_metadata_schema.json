    "facetPolaritySemantics": {
      "description": "facet_trigger / deny_trigger drawn from a facets_v1 leaf's triggers/deny_triggers list. facet is CLOSED to the ten pinned facet_families (SAN-881 PASS 2B.2 -- previously an open ^facet:[a-z_]+$ pattern); the per-facet allOf branches above additionally pin polarity/table_path to the declared facet + kind.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet",
        "polarity"
      ],
      "properties": {
        "facet": {
          "enum": [
            "facet:availability",
            "facet:refund_availability",
            "facet:exchange_availability",
            "facet:discount_availability",
            "facet:access_permission",
            "facet:approval_requirement",
            "facet:eligibility",
            "facet:cost",
            "facet:duration",
            "facet:limit"
          ]
        },
        "polarity": {
          "enum": [
            "POS",
            "NEG"
          ]
        }
      }
    },
    "facetprojSemantics": {
      "description": "facet_trigger drawn from facetproj_v1 (a cross-facet projection, e.g. a discount_availability surface projecting onto a different facet). NEVER a legal binding for deny_trigger (see the lexicalSurfaceFeature allOf's explicit then:false branch). SAN-881 PASS 2B.2-FIX: projects_to is CLOSED to the ten pinned facet_families (previously an open ^facet:[a-z_]+$ pattern) -- the same closed vocabulary facetPolaritySemantics.facet already uses.",
