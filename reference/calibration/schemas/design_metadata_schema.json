{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanna.dev/schemas/calibration/design_metadata/v2.json",
  "title": "SAN-881 calibration corpus design metadata",
  "description": "Sealed authoring artifact: per-item design rationale (target check/stratum, domain, facet families, scenario grouping, minimal-pair pointers, introduced_feature). NEVER derived by running the evaluator. table_path is a CLOSED enum of the exact pinned table locations; intended_semantics is a closed, per-kind discriminated shape (no open-ended objects). SAN-881 PASS 2B.2: introduced_feature is a TEN-branch closed discriminated union (comparator REMOVED from the vocabulary -- comparator parsing/coverage/measurement are untouched product features, but comparators_v1 is no longer a legal introduced_feature TARGET table) with explicit kind-to-table BINDING: every kind is pinned to its own single table_path (facet_trigger additionally to facetproj_v1; deny_trigger NEVER to facetproj_v1), and facet_trigger/deny_trigger are additionally bound, per declared facet, to the MATCHING facets_v1 leaf with the MATCHING polarity; definitive/hedge are additionally bound to a role matching their own kind name.",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "description": "SAN-881 Phase-A correction: exactly 160 items (schema-level, not merely validator-level).",
      "type": "array",
      "minItems": 160,
      "maxItems": 160,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "target_check_id",
        "target_stratum",
        "domain",
        "facet_families",
        "scenario_id",
        "minimal_pair_of",
        "introduced_feature"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^cal:[0-9]{3}$"
        },
        "target_check_id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4"
          ]
        },
        "target_stratum": {
          "enum": [
            "in_domain_nonviolation",
            "in_domain_violation",
            "determinate_out_of_domain",
            "indeterminate_or_unsafe"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "facet_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^facet:[a-z_]+$"
          }
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "minimal_pair_of": {
          "description": "One-way pointer to a unique in-domain control item (cal:NNN). Non-null only for determinate_out_of_domain items; null everywhere else.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^cal:[0-9]{3}$"
        },
        "introduced_feature": {
          "description": "Non-null only for determinate_out_of_domain items; null everywhere else. Closed discriminated union: lexical-surface features or pair-relation features.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/lexicalSurfaceFeature"
            },
            {
              "$ref": "#/$defs/pairRelationFeature"
            }
          ]
        }
      }
    },
    "closedTablePath": {
      "description": "Every facet also has a .triggers and .deny_triggers leaf path (facet_trigger / deny_trigger features point at the specific leaf they draw from); facetproj_v1 is the FACETPROJ cross-facet projection table used by some facet_trigger features instead of a facets_v1 leaf. SAN-881 PASS 2B.2: comparators_v1 REMOVED -- comparator is no longer a legal introduced_feature kind, so its table is no longer a legal introduced_feature table_path target (comparator parsing/coverage/measurement elsewhere are untouched).",
      "enum": [
        "facets_v1.facet:availability.triggers",
        "facets_v1.facet:availability.deny_triggers",
        "facets_v1.facet:refund_availability.triggers",
        "facets_v1.facet:refund_availability.deny_triggers",
        "facets_v1.facet:exchange_availability.triggers",
        "facets_v1.facet:exchange_availability.deny_triggers",
        "facets_v1.facet:discount_availability.triggers",
        "facets_v1.facet:discount_availability.deny_triggers",
        "facets_v1.facet:access_permission.triggers",
        "facets_v1.facet:access_permission.deny_triggers",
        "facets_v1.facet:approval_requirement.triggers",
        "facets_v1.facet:approval_requirement.deny_triggers",
        "facets_v1.facet:eligibility.triggers",
        "facets_v1.facet:eligibility.deny_triggers",
        "facets_v1.facet:cost.triggers",
        "facets_v1.facet:cost.deny_triggers",
        "facets_v1.facet:duration.triggers",
        "facets_v1.facet:duration.deny_triggers",
        "facets_v1.facet:limit.triggers",
        "facets_v1.facet:limit.deny_triggers",
        "facetproj_v1",
        "concept_v1",
        "units_v1",
        "condition_operators_v1",
        "quant_v1",
        "definitive_v1",
        "hedge_v1",
        "excl_v1",
        "complement_v1"
      ]
    },
    "lexicalSurfaceFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "table_path",
        "surface_tokens",
        "intended_semantics"
      ],
      "properties": {
        "kind": {
          "enum": [
            "facet_trigger",
            "deny_trigger",
            "concept",
            "unit",
            "condition_operator",
            "quantifier",
            "definitive",
            "hedge"
          ]
        },
        "table_path": {
          "$ref": "#/$defs/closedTablePath"
        },
        "surface_tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "intended_semantics": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "facet_trigger"
              },
              "table_path": {
                "const": "facetproj_v1"
              }
            },
            "required": [
              "kind",
              "table_path"
            ]
          },
          "then": {
            "properties": {
              "intended_semantics": {
                "$ref": "#/$defs/facetprojSemantics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "deny_trigger"
              },
              "table_path": {
                "const": "facetproj_v1"
              }
            },
            "required": [
              "kind",
              "table_path"
            ]
          },
          "then": false
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "facet_trigger",
                  "deny_trigger"
                ]
              }
            },
            "not": {
              "properties": {
                "table_path": {
                  "const": "facetproj_v1"
                }
              }
            }
          },
          "then": {
            "properties": {
              "intended_semantics": {
                "$ref": "#/$defs/facetPolaritySemantics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "facet_trigger"
              },
              "intended_semantics": {
                "type": "object",
                "required": [
                  "facet"
                ],
                "properties": {
                  "facet": {
                    "const": "facet:availability"
                  }
                }
              }
            },
            "required": [
              "kind",
              "intended_semantics"
            ]
          },
          "then": {
            "properties": {
              "table_path": {
                "const": "facets_v1.facet:availability.triggers"
              },
              "intended_semantics": {
                "type": "object",
                "required": [
                  "polarity"
                ],
                "properties": {
                  "polarity": {
                    "const": "POS"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "deny_trigger"
              },
              "intended_semantics": {
                "type": "object",
                "required": [
                  "facet"
                ],
                "properties": {
                  "facet": {
                    "const": "facet:availability"
                  }
                }
              }
            },
            "required": [
              "kind",
              "intended_semantics"
            ]
          },
